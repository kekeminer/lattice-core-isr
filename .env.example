# ==============================================================================
# LATTICE-CORE ISR - Configuración de Entorno Táctico & Monocromo C2
# ==============================================================================

# Flujo de Video Edge (IP Webcam / RTSP / HTTP)
LATTICE_STREAM_URL=http://192.168.1.50:8080/video
LATTICE_STREAM_TIMEOUT_SECONDS=5.0
LATTICE_RECONNECT_INITIAL_DELAY=1.0
LATTICE_RECONNECT_MAX_DELAY=30.0
LATTICE_RECONNECT_BACKOFF_FACTOR=2.0

# Optimización de Memoria y Buffer (< 100 MB RAM Hard Boundary)
LATTICE_FRAME_BUFFER_SIZE=3
LATTICE_FRAME_WIDTH=1280
LATTICE_FRAME_HEIGHT=720

# Parámetros del Motor Térmico & Visión (RGB Principal / Conmutable a Térmico)
LATTICE_THERMAL_PALETTE=WHITE_HOT
LATTICE_HOTSPOT_MIN_AREA=450
LATTICE_HOTSPOT_BRIGHTNESS_THRESHOLD=215
LATTICE_MAX_TARGETS_PER_FRAME=5
LATTICE_INFERENCE_WIDTH=640
LATTICE_INFERENCE_HEIGHT=384
LATTICE_THREAT_TRIGGER_AREA=1200

# Parámetros de Seguimiento (Tracker & Purga Rápida)
LATTICE_TRACKER_MAX_DISAPPEARED_FRAMES=5
LATTICE_LOG_ALERT_THROTTLE_SECONDS=2.0
LATTICE_TRACKER_MAX_DISTANCE_PX=85.0
LATTICE_TRACKER_TRAJECTORY_MAX_POINTS=25

# Telemetría y Geolocalización Táctica
LATTICE_BASE_SENSOR_LAT=-31.624510
LATTICE_BASE_SENSOR_LON=-60.485120
LATTICE_BASE_SENSOR_ALT_M=25.0
LATTICE_CAMERA_FOV_HORIZONTAL_DEG=65.0
LATTICE_CAMERA_FOV_VERTICAL_DEG=45.0
LATTICE_CAMERA_HEADING_AZIMUTH_DEG=0.0
LATTICE_GROUND_DISTANCE_ESTIMATE_M=35.0

# Geofence & Perímetro de Seguridad (Radio en metros o Polígono)
LATTICE_GEOFENCE_RADIUS_METERS=15.0
LATTICE_GEOFENCE_ALERT_AUTO_EXPORT=true
LATTICE_GEOFENCE_MIN_BREACH_SECONDS=3.0
LATTICE_HARD_RAM_LIMIT_MB=900.0
LATTICE_WARNING_RAM_THRESHOLD_MB=850.0

# Detección Neuronal YOLOv8 & Clases Críticas
LATTICE_YOLO_ENABLED=true
LATTICE_YOLO_MODEL_NAME=yolov8n.pt
LATTICE_YOLO_CONFIDENCE_THRESHOLD=0.40
LATTICE_CRITICAL_CLASSES=["person","car","truck","motorcycle","bicycle","bus","tv","laptop","chair","backpack"]

# Alertas Audibles & Clips Forenses
LATTICE_AUDIO_ALERTS_ENABLED=true
LATTICE_AUDIO_COOLDOWN_SECONDS=5.0
LATTICE_VIDEO_CLIP_ENABLED=true
LATTICE_VIDEO_CLIP_PRE_BUFFER_SECONDS=3.0

# Análisis de Conducta e Intención Táctica (Behavior Analyzer)
LATTICE_BEHAVIOR_LOITER_RADIUS_PX=40.0
LATTICE_BEHAVIOR_LOITER_SECONDS_THRESHOLD=3.0
LATTICE_BEHAVIOR_APPROACHING_MIN_SPEED_PX_S=8.0

# Servidor Web Bridge & Telemetría en Tiempo Real
LATTICE_WEB_ENABLED=true
LATTICE_WEB_HOST=127.0.0.1
LATTICE_WEB_PORT=8000
LATTICE_WEB_TELEMETRY_RATE_HZ=10.0
LATTICE_API_AUTH_TOKEN=lattice2026

# Base de Datos de Borde Embebida (SQLite)
LATTICE_DB_PATH=./lattice_telemetry.db

# Persistencia y Auditoría Obsidian
LATTICE_VAULT_PATH=./obsidian_vault
LATTICE_SOURCE_DEVICE_NAME="Xiaomi Redmi Note 13 Pro"

# Seguridad y Logging
LATTICE_ALLOW_LOCAL_NETWORK_ONLY=true
LATTICE_LOG_LEVEL=INFO
LATTICE_LOG_JSON_FORMAT=true
